---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Home"
  description="Professional USPAP-compliant appraisals of antiques, collectibles, decorative arts, residential contents, and motor vehicles in Dallas, Texas — since 2002."
>
  <section class="hero">
    <img class="hero-logo" src="/images/mag-logo.png" alt="" width="180" height="180" />
    <h1>Professional Appraisals of Personal Property &amp; Motor Vehicles</h1>
    <p class="uspap">
      Providing USPAP*-compliant appraisals of antiques, collectibles, decorative
      arts, residential contents, and motor vehicles since 2002. Team leader when
      other (specialist) appraisers are needed.
    </p>
    <p class="footnote">
      *The Appraisal Foundation&rsquo;s Uniform Standards of Professional Appraisal Practice
    </p>
  </section>

  <div class="container">
    <section class="services">
      <div class="card">
        <h2>Personal Property Appraisals</h2>
        <p class="name">Carol Matesic, ISA CAPP</p>
        <p class="creds">
          Certified Appraiser of Personal Property<br />
          International Society of Appraisers
        </p>
        <p class="contact-line"><a href="tel:214-244-0903">214-244-0903</a></p>
        <p class="contact-line"><a href="mailto:carol@matesicag.com">carol@matesicag.com</a></p>
        <a class="btn" href="/about-us#carol">Learn more</a>
      </div>
      <div class="card">
        <h2>Motor Vehicle Appraisals</h2>
        <p class="name">Gary Matesic, AEP&reg;, TEP&reg;</p>
        <p class="creds">
          Accredited Estate Planner<br />
          Trust and Estate Practitioner
        </p>
        <p class="contact-line"><a href="tel:214-704-3352">214-704-3352</a></p>
        <p class="contact-line"><a href="mailto:gary@matesicag.com">gary@matesicag.com</a></p>
        <a class="btn" href="/about-us#gary">Learn more</a>
      </div>
    </section>
  </div>

  <section class="credentials" aria-label="Professional associations">
    <div class="container">
      <a href="https://www.isa-appraisers.org/" rel="noopener">
        <img src="/images/isa_logo.png" alt="International Society of Appraisers" />
      </a>
      <a href="https://www.naepc.org/" rel="noopener">
        <img src="/images/naepc-logo.png" alt="National Association of Estate Planners and Councils" />
      </a>
      <a href="https://www.step.org/" rel="noopener">
        <img src="/images/step-logo.png" alt="Society of Trust and Estate Practitioners" />
      </a>
    </div>
  </section>
</BaseLayout>
