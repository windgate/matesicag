---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="About Us"
  description="Meet Carol Matesic, ISA CAPP, Certified Appraiser of Personal Property, and Gary Matesic, AEP, TEP, motor vehicle appraiser — the team behind Matesic Appraisal Group in Dallas."
>
  <section class="page-title">
    <h1>About Us</h1>
  </section>

  <div class="container">
    <section class="bio" id="carol">
      <div>
        <img class="portrait" src="/images/carol.jpg" alt="Carol Matesic" width="375" height="375" />
        <div class="affiliate">
          <p><strong>For information on estate and moving sale services:</strong></p>
          <a href="https://jlatreasures.com" rel="noopener">
            <img src="/images/jla-logo.png" alt="JLA Treasures" width="150" height="150" />
          </a>
        </div>
      </div>
      <div>
        <h2>Carol Matesic, ISA CAPP</h2>
        <p>
          Carol began preparing personal property and residential contents appraisals
          in 2002, as an adjunct to her already-successful estate liquidation business.
          Since that time, she has performed valuations, and acted as team leader of
          appraisers, for some of the largest, most complex estates in North Texas.
          Her client list resembles a Who&rsquo;s Who of business and philanthropic leaders
          from the past 50 years.
        </p>
        <p>
          A Certified Appraiser of Personal Property with the International Society of
          Appraisers, the highest level available, she is involved with national
          leadership, and works closely with local and regional specialists in that
          organization. She is also a member of ISA&rsquo;s Private Client Services Group, a
          select group of qualified appraisers who have completed specialized training
          and hold senior-level industry experience in working with High-Net-Worth
          Individuals. Carol currently serves as national Vice President for the ISA
          Education Foundation, formerly the Foundation for Appraisal Education.
        </p>
      </div>
    </section>

    <section class="bio" id="gary">
      <div>
        <img class="portrait" src="/images/gary.jpg" alt="Gary Matesic" width="375" height="375" />
        <div class="affiliate">
          <p><strong>For information on trust/estate expert consulting and sales of estate vehicles:</strong></p>
          <a href="https://trustmangroup.com" rel="noopener">
            <img src="/images/trust-logo.png" alt="Trust Management Group" width="150" height="150" />
          </a>
        </div>
      </div>
      <div>
        <h2>Gary Matesic, AEP&reg;, TEP&reg;</h2>
        <p>
          Starting as a Trust Tax Administrator more than 50 years ago with a major
          national bank, Gary has been involved professionally with the administration
          of decedents&rsquo; estates since 1976. His experience includes hiring appraisers
          to value personal property and other estate assets for inclusion in Federal
          Estate Tax Returns.
        </p>
        <p>
          An automobile enthusiast since early childhood, Gary owned a Texas-licensed
          Independent Motor Vehicle Dealership from 1996&ndash;2005, and began preparing
          written appraisals of both collectible and non-collectible cars and trucks in
          1999. He has appraised numerous single vehicles, collections in estates for
          ultra-high-net-worth families, and appraised, prepared for sale, and
          successfully sold at auction a collection of 76 vehicles in a contested
          divorce. Gary successfully completed the 15-Hour National USPAP Course
          (2024&ndash;2025 cycle), including examination.
        </p>
      </div>
    </section>
  </div>

  <section class="credentials" aria-label="Professional associations">
    <div class="container">
      <a href="https://www.isa-appraisers.org/" rel="noopener">
        <img src="/images/isa_logo.png" alt="International Society of Appraisers" />
      </a>
      <a href="https://www.naepc.org/" rel="noopener">
        <img src="/images/naepc-logo.png" alt="National Association of Estate Planners and Councils" />
      </a>
      <a href="https://www.step.org/" rel="noopener">
        <img src="/images/step-logo.png" alt="Society of Trust and Estate Practitioners" />
      </a>
    </div>
  </section>
</BaseLayout>
